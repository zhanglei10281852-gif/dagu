+	}
+	limit := 0
+	if request.Params.Limit != nil {
+		limit = *request.Params.Limit
+	}
+	page, err := controller.ListDeliveryRecords(ctx, filter, cursor, limit)
+	if err != nil {
+		return nil, badIncidentRequest(err.Error())
+	}
+	var nextCursor *string
