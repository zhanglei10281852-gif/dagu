+	assert.Same(t, monitor1, registry.Active())
+
+	// A stale owner must not clear the new owner.
+	registry.SetActive(monitor2)
+	registry.ClearActive(monitor1)
+	assert.Same(t, monitor2, registry.Active())
+
+	registry.ClearActive(monitor2)
+	assert.Nil(t, registry.Active())
+
+	// Nil-safe for monitors without registry.
+	monitor1.SetRegistry(nil)
+	monitor1.registerActive()
+	monitor1.endNotificationSession()
+}
diff --git a/internal/service/chatbridge/delivery_records.go b/internal/service/chatbridge/delivery_records.go
new file mode 100644
index 000000000..51c17f704
--- /dev/null
+++ b/internal/service/chatbridge/delivery_records.go
@@ -0,0 +1,245 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package chatbridge
+
+import (
+	"time"
+
+	"github.com/dagucloud/dagu/v2/internal/eventstore"
+)
+
+// DeliveryStatus is the lifecycle state of one event delivery record.
+type DeliveryStatus string
+
+const (
+	DeliveryStatusPending    DeliveryStatus = "pending"
+	DeliveryStatusDelivered  DeliveryStatus = "delivered"
+	DeliveryStatusDeadLetter DeliveryStatus = "dead_letter"
+)
+
+// DeliveryErrorCategory classifies the most recent delivery failure.
+type DeliveryErrorCategory string
+
+const (
+	DeliveryErrorRateLimited   DeliveryErrorCategory = "rate_limited"
+	DeliveryErrorServerError   DeliveryErrorCategory = "server_error"
+	DeliveryErrorNetwork       DeliveryErrorCategory = "network"
+	DeliveryErrorClientError   DeliveryErrorCategory = "client_error"
+	DeliveryErrorConfiguration DeliveryErrorCategory = "configuration"
+	DeliveryErrorUnknown       DeliveryErrorCategory = "unknown"
+)
+
+// Dead-letter reasons.
+const (
+	deadLetterReasonClientError  = "client_error"
+	deadLetterReasonAttemptLimit = "attempt_limit"
+	deadLetterReasonConfiguration = "configuration"
+)
+
+// deliveryEventSummary is the compact event information retained after an
+// event reaches a terminal state, when the full status snapshot is no longer
+// needed for rendering or redrive.
+type deliveryEventSummary struct {
+	Key        string               `json:"key,omitempty"`
+	Type       eventstore.EventType `json:"type,omitempty"`
+	DAGName    string               `json:"dag_name,omitempty"`
+	RunStatus  uint8                `json:"run_status,omitempty"`
+	DAGRunID   string               `json:"dag_run_id,omitempty"`
+	AttemptID  string               `json:"attempt_id,omitempty"`
+	DAGFile    string               `json:"dag_file,omitempty"`
+	ObservedAt time.Time            `json:"observed_at,omitempty"`
+}
+
+// notificationDeliveryRecord tracks the delivery lifecycle of one event for
+// one destination. The full event snapshot is retained while the record is
+// pending or dead-lettered (required for batch rendering and manual redrive)
+// and released once delivered.
+type notificationDeliveryRecord struct {
+	Status  DeliveryStatus      `json:"status"`
+	Event   *NotificationEvent  `json:"event,omitempty"`
+	Summary *deliveryEventSummary `json:"summary,omitempty"`
+
+	Attempts   int `json:"attempts,omitempty"`
+	Generation int `json:"generation,omitempty"`
+
+	LastErrorCategory DeliveryErrorCategory `json:"last_error_category,omitempty"`
+	LastErrorSummary  string                `json:"last_error_summary,omitempty"`
+	LastAttemptAt     *time.Time            `json:"last_attempt_at,omitempty"`
+	NextAttemptAt     *time.Time            `json:"next_attempt_at,omitempty"`
+
+	DeliveredAt      *time.Time `json:"delivered_at,omitempty"`
+	DeadLetterAt     *time.Time `json:"dead_letter_at,omitempty"`
+	DeadLetterReason string     `json:"dead_letter_reason,omitempty"`
+
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+func newPendingDeliveryRecord(event NotificationEvent, now time.Time) *notificationDeliveryRecord {
+	event = cloneNotificationEvent(event)
+	if now.IsZero() {
+		now = time.Now().UTC()
+	}
+	observedAt := event.ObservedAt
+	if observedAt.IsZero() {
+		observedAt = now
+	}
+	return &notificationDeliveryRecord{
+		Status:     DeliveryStatusPending,
+		Event:      &event,
+		Generation: 1,
+		CreatedAt:  observedAt,
+		UpdatedAt:  now,
+	}
+}
+
+func newDeliveredDeliveryRecord(key string, deliveredAt time.Time) *notificationDeliveryRecord {
+	if deliveredAt.IsZero() {
+		deliveredAt = time.Now().UTC()
+	}
+	return &notificationDeliveryRecord{
+		Status:      DeliveryStatusDelivered,
+		Summary:     &deliveryEventSummary{Key: key},
+		DeliveredAt: &deliveredAt,
+		CreatedAt:   deliveredAt,
+		UpdatedAt:   deliveredAt,
+	}
+}
+
+func (r *notificationDeliveryRecord) eventKey() string {
+	if r == nil {
+		return ""
+	}
+	if r.Event != nil && r.Event.Key != "" {
+		return r.Event.Key
+	}
+	if r.Summary != nil {
+		return r.Summary.Key
+	}
+	return ""
+}
+
+func (r *notificationDeliveryRecord) observedAt() time.Time {
+	if r == nil {
+		return time.Time{}
+	}
+	if r.Event != nil && !r.Event.ObservedAt.IsZero() {
+		return r.Event.ObservedAt
+	}
+	if r.Summary != nil {
+		return r.Summary.ObservedAt
+	}
+	return r.CreatedAt
+}
+
+// notificationEvent returns the full pending/dead-letter event snapshot, or
+// false for terminal delivered records that no longer carry one.
+func (r *notificationDeliveryRecord) notificationEvent() (NotificationEvent, bool) {
+	if r != nil && r.Event != nil {
+		return *r.Event, true
+	}
+	return NotificationEvent{}, false
+}
+
+func (r *notificationDeliveryRecord) isPending() bool {
+	return r != nil && r.Status == DeliveryStatusPending && r.Event != nil
+}
+
+// dueNotificationEvent returns the pending event when it is eligible for
+// (re)delivery at now: pending records without a scheduled time are always
+// due, while records waiting on a backoff schedule are due at or after it.
+func (r *notificationDeliveryRecord) dueNotificationEvent(now time.Time) (NotificationEvent, bool) {
+	if !r.isPending() {
+		return NotificationEvent{}, false
+	}
+	if r.NextAttemptAt != nil && r.NextAttemptAt.After(now) {
+		return NotificationEvent{}, false
+	}
+	if r.Event.Status == nil || r.Event.Key == "" {
+		return NotificationEvent{}, false
+	}
+	return *r.Event, true
+}
+
+// newDeliveredRecordFromEvent acknowledges an event that has no live lifecycle
+// record, retaining only the compact event summary.
+func newDeliveredRecordFromEvent(event NotificationEvent, now time.Time) *notificationDeliveryRecord {
+	createdAt := event.ObservedAt
+	if createdAt.IsZero() {
+		createdAt = now
+	}
+	return &notificationDeliveryRecord{
+		Status:      DeliveryStatusDelivered,
+		Summary:     compactDeliveryEventSummary(event),
+		Generation:  1,
+		DeliveredAt: &now,
+		CreatedAt:   createdAt,
+		UpdatedAt:   now,
+	}
+}
+
+// deliveredRecordFromPending converts an acknowledged pending record into a
+// delivered one, preserving lifecycle metadata while releasing the potentially
+// large status snapshot.
+func deliveredRecordFromPending(record *notificationDeliveryRecord, event NotificationEvent, now time.Time) *notificationDeliveryRecord {
+	createdAt := record.CreatedAt
+	if createdAt.IsZero() {
+		createdAt = event.ObservedAt
+	}
+	return &notificationDeliveryRecord{
+		Status:          DeliveryStatusDelivered,
+		Summary:         compactDeliveryEventSummary(event),
+		Attempts:        record.Attempts,
+		Generation:      record.Generation,
+		DeliveredAt:     &now,
+		CreatedAt:       createdAt,
+		UpdatedAt:       now,
+	}
+}
+
+// compactSummary extracts display-only event information before the full
+// status snapshot is released.
+func compactDeliveryEventSummary(event NotificationEvent) *deliveryEventSummary {
+	summary := &deliveryEventSummary{
+		Key:        event.Key,
+		Type:       event.Type,
+		DAGFile:    event.DAGFile,
+		ObservedAt: event.ObservedAt,
+	}
+	if event.Status != nil {
+		summary.DAGName = event.Status.Name
+		summary.RunStatus = uint8(event.Status.Status)
+		summary.DAGRunID = event.Status.DAGRunID
+		summary.AttemptID = event.Status.AttemptID
+	}
+	return summary
+}
+
+func cloneDeliveryRecord(record *notificationDeliveryRecord) *notificationDeliveryRecord {
+	if record == nil {
+		return nil
+	}
+	clone := *record
+	if record.Event != nil {
+		event := cloneNotificationEvent(*record.Event)
+		clone.Event = &event
+	}
+	if record.Summary != nil {
+		summary := *record.Summary
+		clone.Summary = &summary
+	}
+	clone.LastAttemptAt = cloneTimePtr(record.LastAttemptAt)
+	clone.NextAttemptAt = cloneTimePtr(record.NextAttemptAt)
+	clone.DeliveredAt = cloneTimePtr(record.DeliveredAt)
+	clone.DeadLetterAt = cloneTimePtr(record.DeadLetterAt)
+	return &clone
+}
+
+func cloneTimePtr(value *time.Time) *time.Time {
+	if value == nil {
+		return nil
+	}
+	clone := *value
+	return &clone
+}
diff --git a/internal/service/chatbridge/delivery_records_test.go b/internal/service/chatbridge/delivery_records_test.go
new file mode 100644
index 000000000..062f41a03
--- /dev/null
+++ b/internal/service/chatbridge/delivery_records_test.go
@@ -0,0 +1,229 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package chatbridge
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/dagucloud/dagu/v2/internal/eventstore"
+	"github.com/dagucloud/dagu/v2/internal/ir"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func pendingRecordsOf(destState *notificationDestinationState) map[string]*notificationDeliveryRecord {
+	pending := make(map[string]*notificationDeliveryRecord)
+	if destState == nil {
+		return pending
+	}
+	for key, record := range destState.Records {
+		if record.isPending() {
+			pending[key] = record
+		}
+	}
+	return pending
+}
+
+// marshalV1State encodes a destination state using only the legacy v1 tables.
+func marshalV1State(t *testing.T, pending map[string]NotificationEvent, delivered map[string]time.Time) []byte {
+	t.Helper()
+	raw := struct {
+		Version      int                                      `json:"version"`
+		Bootstrapped bool                                     `json:"bootstrapped"`
+		SourceCursor eventstore.DAGRunCursor                  `json:"source_cursor"`
+		Destinations map[string]*notificationDestinationState `json:"destinations"`
+	}{
+		Version:      1,
+		Bootstrapped: true,
+		SourceCursor: eventstore.DAGRunCursor{CommittedOffsets: map[string]int64{"events": 7}},
+		Destinations: map[string]*notificationDestinationState{
+			"dest-1": {
+				Pending:   pending,
+				Delivered: delivered,
+			},
+		},
+	}
+	data, err := json.Marshal(raw)
+	require.NoError(t, err)
+	return data
+}
+
+func TestDecodeNotificationMonitorState_MigratesV1Losslessly(t *testing.T) {
+	t.Parallel()
+
+	observedAt := time.Now().UTC().Add(-time.Minute)
+	deliveredAt := time.Now().UTC().Add(-2 * time.Minute)
+	status := &ir.DAGRunStatus{
+		Name:      "briefing",
+		Status:    ir.Failed,
+		DAGRunID:  "run-migrate",
+		AttemptID: "attempt-migrate",
+		Error:     "boom",
+		Labels:    []string{"workspace=ops"},
+	}
+	pendingEvent := NotificationEvent{
+		Key:        NotificationSeenKey(status),
+		Type:       eventstore.TypeDAGRunFailed,
+		Status:     status,
+		DAGFile:    "briefing-file",
+		ObservedAt: observedAt,
+	}
+	data := marshalV1State(t,
+		map[string]NotificationEvent{pendingEvent.Key: pendingEvent},
+		map[string]time.Time{"legacy-delivered-key": deliveredAt},
+	)
+
+	state, err := decodeNotificationMonitorState(data)
+	require.NoError(t, err)
+
+	assert.True(t, state.Bootstrapped)
+	assert.Equal(t, int64(7), state.SourceCursor.CommittedOffsets["events"])
+	destState := state.Destinations["dest-1"]
+	require.NotNil(t, destState)
+	assert.Nil(t, destState.Pending)
+	assert.Nil(t, destState.Delivered)
+	require.Len(t, destState.Records, 2)
+
+	pending := destState.Records[pendingEvent.Key]
+	require.NotNil(t, pending)
+	assert.Equal(t, DeliveryStatusPending, pending.Status)
+	require.NotNil(t, pending.Event)
+	assert.Equal(t, "run-migrate", pending.Event.Status.DAGRunID)
+	assert.Equal(t, "briefing-file", pending.Event.DAGFile)
+	assert.Equal(t, []string{"workspace=ops"}, pending.Event.Status.Labels)
+	assert.Equal(t, observedAt, pending.Event.ObservedAt)
+	assert.Zero(t, pending.Attempts)
+	assert.Nil(t, pending.NextAttemptAt)
+
+	delivered := destState.Records["legacy-delivered-key"]
+	require.NotNil(t, delivered)
+	assert.Equal(t, DeliveryStatusDelivered, delivered.Status)
+	require.NotNil(t, delivered.DeliveredAt)
+	assert.Equal(t, deliveredAt, *delivered.DeliveredAt)
+	require.NotNil(t, delivered.Summary)
+	assert.Equal(t, "legacy-delivered-key", delivered.Summary.Key)
+	assert.Nil(t, delivered.Event)
+
+	// A v2 round trip must serialize only records and stay lossless.
+	encoded, err := json.Marshal(state)
+	require.NoError(t, err)
+	assert.NotContains(t, string(encoded), `"pending":`)
+	assert.NotContains(t, string(encoded), `"delivered":`)
+
+	roundTrip, err := decodeNotificationMonitorState(encoded)
+	require.NoError(t, err)
+	assert.Len(t, roundTrip.Destinations["dest-1"].Records, 2)
+}
+
+func TestDecodeNotificationMonitorState_MissingVersionIsAccepted(t *testing.T) {
+	t.Parallel()
+
+	status := &ir.DAGRunStatus{Name: "briefing", Status: ir.Failed, DAGRunID: "r1", AttemptID: "a1"}
+	event := NotificationEvent{Key: NotificationSeenKey(status), Type: eventstore.TypeDAGRunFailed, Status: status}
+	data := marshalV1State(t, map[string]NotificationEvent{event.Key: event}, nil)
+	// Strip the version field to simulate the oldest on-disk files.
+	var raw map[string]any
+	require.NoError(t, json.Unmarshal(data, &raw))
+	delete(raw, "version")
+	data, err := json.Marshal(raw)
+	require.NoError(t, err)
+
+	state, err := decodeNotificationMonitorState(data)
+	require.NoError(t, err)
+	require.Contains(t, state.Destinations, "dest-1")
+	assert.Len(t, pendingRecordsOf(state.Destinations["dest-1"]), 1)
+}
+
+func TestCloneNotificationMonitorState_DeepCopiesRecords(t *testing.T) {
+	t.Parallel()
+
+	now := time.Now().UTC()
+	next := now.Add(time.Minute)
+	status := &ir.DAGRunStatus{Name: "briefing", Status: ir.Failed, DAGRunID: "r1", AttemptID: "a1"}
+	event := NotificationEvent{
+		Key:        NotificationSeenKey(status),
+		Type:       eventstore.TypeDAGRunFailed,
+		Status:     status,
+		ObservedAt: now,
+	}
+	original := newNotificationMonitorState()
+	original.Destinations["dest-1"] = &notificationDestinationState{
+		Records: map[string]*notificationDeliveryRecord{
+			event.Key: {
+				Status:             DeliveryStatusPending,
+				Event:              &event,
+				Summary:            compactDeliveryEventSummary(event),
+				Attempts:           3,
+				Generation:         2,
+				LastErrorCategory:  DeliveryErrorServerError,
+				LastErrorSummary:   "HTTP 503",
+				LastAttemptAt:      &now,
+				NextAttemptAt:      &next,
+				CreatedAt:          now,
+				UpdatedAt:          now,
+			},
+		},
+	}
+
+	clone := cloneNotificationMonitorState(original)
+	clonedRecord := clone.Destinations["dest-1"].Records[event.Key]
+	clonedRecord.Attempts = 99
+	clonedRecord.Event.Status.Name = "changed"
+	clonedRecord.Summary.DAGName = "changed-summary"
+	*clonedRecord.NextAttemptAt = now.Add(time.Hour)
+
+	sourceRecord := original.Destinations["dest-1"].Records[event.Key]
+	assert.Equal(t, 3, sourceRecord.Attempts)
+	assert.Equal(t, "briefing", sourceRecord.Event.Status.Name)
+	assert.Equal(t, "briefing", sourceRecord.Summary.DAGName)
+	assert.Equal(t, next, *sourceRecord.NextAttemptAt)
+}
+
+func TestSaveBumpsV1StateToV2(t *testing.T) {
+	t.Parallel()
+
+	deliveredAt := time.Now().UTC()
+	destination := &notificationDestinationState{
+		Delivered: map[string]time.Time{"legacy-delivered-key": deliveredAt},
+	}
+	state := newNotificationMonitorState()
+	state.Version = 1
+	state.Bootstrapped = true
+	state.Destinations["dest-1"] = destination
+
+	data, err := json.Marshal(state)
+	require.NoError(t, err)
+	store := newNotificationStateStore(&memoryStateStoreForTest{data: data})
+	require.NoError(t, store.Save(context.Background(), state))
+
+	result := store.Load(context.Background())
+	require.NoError(t, result.Warning)
+	assert.Equal(t, notificationMonitorStateVersion, result.State.Version)
+	migrated := result.State.Destinations["dest-1"].Records["legacy-delivered-key"]
+	require.NotNil(t, migrated)
+	assert.Equal(t, DeliveryStatusDelivered, migrated.Status)
+}
+
+type memoryStateStoreForTest struct {
+	data []byte
+}
+
+func (s *memoryStateStoreForTest) Load(context.Context) ([]byte, bool, error) {
+	if len(s.data) == 0 {
+		return nil, false, nil
+	}
+	return s.data, true, nil
+}
+
+func (s *memoryStateStoreForTest) Save(_ context.Context, data []byte) error {
+	s.data = append([]byte(nil), data...)
+	return nil
+}
+
+func (s *memoryStateStoreForTest) Quarantine(context.Context) (string, error) {
+	return "quarantined", nil
+}
