+          description: "DAG-run not found"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "409":
+          description: "DAG-run is active or its retention state cannot be read"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        default:
+          description: "Generic error response"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+    delete:
+      summary: "Release the retention hold on a DAG-run"
+      description: >-
+        Releases the evidence retention hold so the run follows the DAG's
+        normal history policy again. Developer, manager, or admin only.
+        Repeated deletes are idempotent and succeed when no hold is present.
+      operationId: "deleteDAGRunRetentionLock"
+      tags:
+        - "dag-runs"
+      parameters:
+        - $ref: "#/components/parameters/RemoteNode"
+        - $ref: "#/components/parameters/DAGName"
+        - $ref: "#/components/parameters/DAGRunConcreteId"
+      responses:
+        "204":
+          description: "Retention hold released (or already absent)"
