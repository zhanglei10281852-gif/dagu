+  /dag-runs/{name}/{dagRunId}/retention:
+    put:
+      summary: "Place a retention hold on a finished root DAG-run"
+      description: >-
+        Preserves one finished root DAG-run as evidence without changing the
+        DAG's history retention policy. Developer, manager, or admin only. The
+        'latest' alias, active runs, and child (sub) DAG-runs cannot be held.
+        Repeated puts are idempotent and return the existing hold unchanged.
+        While held, retention cleanup, rm/cleanup, single and batch deletion
+        skip the run and all of its attempts, child runs, logs, artifacts,
+        indexes, working directory, and registered Dagu-owned agent-session
+        resources.
