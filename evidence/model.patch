diff --git a/internal/cmn/config/notification_delivery_config_test.go b/internal/cmn/config/notification_delivery_config_test.go
new file mode 100644
index 000000000..d325ecd1e
--- /dev/null
+++ b/internal/cmn/config/notification_delivery_config_test.go
@@ -0,0 +1,77 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package config
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNotificationDeliveryDefaults(t *testing.T) {
+	v := viper.New()
+	v.SetConfigType("yaml")
+	require.NoError(t, v.ReadConfig(strings.NewReader("")))
+
+	loader := NewConfigLoader(v, WithService(ServiceServer), WithAppHomeDir(t.TempDir()))
+	cfg, err := loader.Load()
+	require.NoError(t, err)
+
+	delivery := cfg.Notification.Delivery
+	assert.Equal(t, 10, delivery.MaxAttempts)
+	assert.Equal(t, 30*time.Second, delivery.InitialBackoff)
+	assert.Equal(t, time.Hour, delivery.MaxBackoff)
+	assert.Equal(t, 14*24*time.Hour, delivery.DeadLetterTTL)
+	assert.Equal(t, 1000, delivery.DeadLetterLimit)
+}
+
+func TestNotificationDeliveryOverrides(t *testing.T) {
+	yaml := `
+notification:
+  delivery:
+    max_attempts: 3
+    initial_backoff: 5s
+    max_backoff: 2m
+    dead_letter_ttl: 24h
+    dead_letter_limit: 42
+`
+	v := viper.New()
+	v.SetConfigType("yaml")
+	require.NoError(t, v.ReadConfig(strings.NewReader(yaml)))
+
+	loader := NewConfigLoader(v, WithService(ServiceServer), WithAppHomeDir(t.TempDir()))
+	cfg, err := loader.Load()
+	require.NoError(t, err)
+
+	delivery := cfg.Notification.Delivery
+	assert.Equal(t, 3, delivery.MaxAttempts)
+	assert.Equal(t, 5*time.Second, delivery.InitialBackoff)
+	assert.Equal(t, 2*time.Minute, delivery.MaxBackoff)
+	assert.Equal(t, 24*time.Hour, delivery.DeadLetterTTL)
+	assert.Equal(t, 42, delivery.DeadLetterLimit)
+}
+
+func TestNotificationDeliveryInvalidDurationWarnsAndKeepsDefault(t *testing.T) {
+	yaml := `
+notification:
+  delivery:
+    initial_backoff: "soon"
+`
+	v := viper.New()
+	v.SetConfigType("yaml")
+	require.NoError(t, v.ReadConfig(strings.NewReader(yaml)))
+
+	loader := NewConfigLoader(v, WithService(ServiceServer), WithAppHomeDir(t.TempDir()))
+	cfg, err := loader.Load()
+	require.NoError(t, err)
+	require.NotEmpty(t, loader.warnings)
+	assert.True(t, strings.Contains(loader.warnings[0], "initial_backoff"))
+	// The invalid value does not get through; chatbridge config normalization
+	// (covered in the chatbridge package) turns zero into the built-in default.
+	assert.Zero(t, cfg.Notification.Delivery.InitialBackoff)
+}
diff --git a/internal/service/chatbridge/delivery_controller_test.go b/internal/service/chatbridge/delivery_controller_test.go
new file mode 100644
index 000000000..0405cf4bb
--- /dev/null
+++ b/internal/service/chatbridge/delivery_controller_test.go
@@ -0,0 +1,110 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package chatbridge
+
+import (
+	"context"
+	"io"
+	"log/slog"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/dagucloud/dagu/v2/internal/eventstore"
+	"github.com/dagucloud/dagu/v2/internal/ir"
+	filemonitor "github.com/dagucloud/dagu/v2/internal/persis/file/monitor"
+	"github.com/dagucloud/dagu/v2/internal/testutil"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// Two monitors contend for one lease with a shared registry. The standby
+// monitor's controller must read state from disk and route redrives to the
+// active owner.
+func TestDeliveryController_RoutesRedriveToLeaseOwner(t *testing.T) {
+	t.Parallel()
+
+	stateFile := filepath.Join(t.TempDir(), "state.json")
+	now := time.Now().UTC()
+	status := &ir.DAGRunStatus{Name: "briefing", Status: ir.Failed, DAGRunID: "run-dl", AttemptID: "attempt-dl"}
+	event := NotificationEvent{
+		Key:        NotificationSeenKey(status),
+		Type:       eventstore.TypeDAGRunFailed,
+		Status:     status,
+		ObservedAt: now,
+	}
+	deadRecord := &notificationDeliveryRecord{
+		Status: DeliveryStatusDeadLetter, Event: &event, Generation: 1,
+		DeadLetterAt: &now, DeadLetterReason: deadLetterReasonClientError,
+		CreatedAt: now, UpdatedAt: now,
+	}
+	state := newNotificationMonitorState()
+	state.Bootstrapped = true
+	state.Destinations["dest-1"] = &notificationDestinationState{
+		Records: map[string]*notificationDeliveryRecord{event.Key: deadRecord},
+	}
+	require.NoError(t, newNotificationStateStore(filemonitor.NewStateStore(stateFile)).Save(context.Background(), state))
+
+	registry := NewMonitorRegistry()
+	cfg := newTestNotificationMonitorConfig()
+	owner := newFileBackedMonitor(nil, stateFile,
+		&fakeNotificationTransport{destinations: []string{"dest-1"}},
+		slog.New(slog.NewTextHandler(io.Discard, nil)), cfg)
+	owner.SetRegistry(registry)
+	standby := newFileBackedMonitor(nil, stateFile,
+		&fakeNotificationTransport{destinations: []string{"dest-1"}},
+		slog.New(slog.NewTextHandler(io.Discard, nil)), cfg)
+	standby.SetRegistry(registry)
+
+	// Start the intended owner first and wait for it to hold the lease before
+	// launching the standby contender; otherwise lock acquisition order between
+	// equal contenders is nondeterministic under load.
+	ownerStop := testutil.StartContextRunner(t, owner)
+	defer ownerStop()
+
+	require.Eventually(t, func() bool {
+		return registry.Active() == owner && owner.ownsNotificationLock()
+	}, notificationMonitorEventuallyTimeout(10*time.Second), 10*time.Millisecond)
+
+	standbyStop := testutil.StartContextRunner(t, standby)
+	defer standbyStop()
+
+	// The standby monitor's controller reads the dead-letter record from disk.
+	standbyController := NewDeliveryController(standby, registry)
+	page, err := standbyController.ListDeliveryRecords(context.Background(), DeliveryRecordFilter{
+		Statuses: []DeliveryStatus{DeliveryStatusDeadLetter},
+	}, "", 10)
+	require.NoError(t, err)
+	require.Len(t, page.Records, 1)
+	assert.Equal(t, event.Key, page.Records[0].EventKey)
+
+	// Redrive through the standby controller is executed by the owner.
+	results, err := standbyController.RedriveDeliveryRecords(context.Background(), []DeliveryRecordRef{{
+		Destination: "dest-1", EventKey: event.Key,
+	}})
+	require.NoError(t, err)
+	require.Len(t, results, 1)
+	assert.Equal(t, RedriveOutcomeRedriven, results[0].Outcome)
+
+	reloaded := newNotificationStateStore(filemonitor.NewStateStore(stateFile)).Load(context.Background())
+	require.NoError(t, reloaded.Warning)
+	reopened := reloaded.State.Destinations["dest-1"].Records[event.Key]
+	require.NotNil(t, reopened)
+	assert.Equal(t, DeliveryStatusPending, reopened.Status)
+	assert.Equal(t, 2, reopened.Generation)
+}
+
+func TestDeliveryController_NoActiveOwnerReturnsInactive(t *testing.T) {
+	t.Parallel()
+
+	stateFile := filepath.Join(t.TempDir(), "state.json")
+	local := newFileBackedMonitor(nil, stateFile,
+		&fakeNotificationTransport{destinations: []string{"dest-1"}},
+		slog.New(slog.NewTextHandler(io.Discard, nil)), newTestNotificationMonitorConfig())
+	registry := NewMonitorRegistry()
+	controller := NewDeliveryController(local, registry)
+
+	_, err := controller.RedriveDeliveryRecords(context.Background(), []DeliveryRecordRef{{Destination: "dest-1", EventKey: "k"}})
+	assert.ErrorIs(t, err, ErrDeliveryControllerInactive)
+}
diff --git a/internal/service/chatbridge/delivery_lifecycle.go b/internal/service/chatbridge/delivery_lifecycle.go
new file mode 100644
index 000000000..06c00ad21
--- /dev/null
+++ b/internal/service/chatbridge/delivery_lifecycle.go
@@ -0,0 +1,240 @@
+// Copyright (C) 2026 Yota Hamada
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package chatbridge
+
+import (
+	"context"
+	"math"
+	"math/rand"
+	"sort"
+	"time"
+)
+
+// deliveryRand jitters persistent backoff intervals. The global source is
+// concurrency-safe and auto-seeded.
+var deliveryRand = rand.New(rand.NewSource(time.Now().UnixNano()))
+
+// deliveryBackoff computes the wait before the next automatic attempt after
+// attempts failed attempts: initial * 2^(attempts-1), capped at max, with
+// +-20% jitter to avoid synchronized retries.
+func (m *NotificationMonitor) deliveryBackoff(attempts int) time.Duration {
+	initial := m.cfg.DeliveryInitialBackoff
+	maxBackoff := m.cfg.DeliveryMaxBackoff
+	if initial <= 0 {
+		initial = DefaultNotificationDeliveryInitialBackoff
+	}
+	if maxBackoff <= 0 {
+		maxBackoff = DefaultNotificationDeliveryMaxBackoff
+	}
+	interval := float64(initial) * math.Pow(2, float64(max(0, attempts-1)))
+	if interval > float64(maxBackoff) {
+		interval = float64(maxBackoff)
+	}
+	factor := 1.0
+	if m.deliveryJitter != nil {
+		factor = 0.8 + 0.4*m.deliveryJitter()
+	}
+	wait := time.Duration(interval * factor)
+	if wait <= 0 {
+		wait = time.Second
+	}
+	return wait
+}
+
+// recordBatchDeliveryFailure accounts one delivery attempt for every live
+// pending record represented by the batch, scheduling persistent backoff or
+// moving the record to the dead-letter. The transition is durable before it is
+// visible in memory, mirroring every other monitor state change.
+func (m *NotificationMonitor) recordBatchDeliveryFailure(ctx context.Context, destination string, batch NotificationBatch, outcome DeliveryOutcome) {
+	now := time.Now().UTC()
+	summary := outcome.Summary
+	if summary == "" {
+		summary = fallbackDeliveryFailureSummary
+	}
+	category := outcome.Category
+	if category == "" {
+		category = DeliveryErrorUnknown
+	}
+
+	m.stateMu.Lock()
+	m.applyStateTransitionLocked(ctx, func(candidate *notificationMonitorState) bool {
+		destState := destinationState(candidate, destination)
+		changed := false
+		for _, event := range batch.Events {
+			if event.Key == "" {
+				continue
+			}
+			record, ok := destState.Records[event.Key]
+			if !ok || record == nil || record.Status != DeliveryStatusPending {
+				continue
+			}
+
+			record.Attempts++
+			record.LastAttemptAt = &now
+			record.LastErrorCategory = category
+			record.LastErrorSummary = summary
+			record.UpdatedAt = now
+			record.NextAttemptAt = nil
+			changed = true
+
+			if !outcome.Retryable {
+				moveRecordToDeadLetter(record, now, deadLetterReasonForCategory(category))
+				continue
+			}
+			if m.cfg.MaxDeliveryAttempts > 0 && record.Attempts >= m.cfg.MaxDeliveryAttempts {
+				moveRecordToDeadLetter(record, now, deadLetterReasonAttemptLimit)
+				continue
+			}
+
+			wait := m.deliveryBackoff(record.Attempts)
+			if outcome.RetryAfter > wait {
+				wait = outcome.RetryAfter
+			}
+			nextAttemptAt := now.Add(wait)
+			record.NextAttemptAt = &nextAttemptAt
+		}
+		// Keep terminal tables bounded immediately when new records land in
+		// them rather than waiting for the next eviction tick.
+		if pruneTerminalRecords(destState, now, m.cfg.SeenTTL, m.cfg.DeadLetterTTL, m.cfg.DeadLetterLimit) {
+			changed = true
+		}
+		return changed
+	})
+	m.stateMu.Unlock()
+}
+
+// moveRecordToDeadLetter stops automatic delivery and retains the full event
+// snapshot for later manual redrive.
+func moveRecordToDeadLetter(record *notificationDeliveryRecord, now time.Time, reason string) {
+	record.Status = DeliveryStatusDeadLetter
+	record.DeadLetterAt = &now
+	record.DeadLetterReason = reason
+	record.NextAttemptAt = nil
+	record.UpdatedAt = now
+}
+
+func deadLetterReasonForCategory(category DeliveryErrorCategory) string {
+	if category == DeliveryErrorConfiguration {
+		return deadLetterReasonConfiguration
+	}
+	return deadLetterReasonClientError
+}
+
+// resetRecordToPending reopens a terminal record as a fresh pending generation,
+// clearing attempt/failure state while preserving identity and event content.
+// It is used for manual redrive and for a re-observed event whose prior record
+// has dead-lettered.
+func resetRecordToPending(record *notificationDeliveryRecord, event NotificationEvent, now time.Time) *notificationDeliveryRecord {
+	generation := record.Generation
+	if generation < 1 {
+		generation = 1
+	}
+	createdAt := record.CreatedAt
+	if createdAt.IsZero() {
+		createdAt = now
+	}
+	snapshot := cloneNotificationEvent(event)
+	return &notificationDeliveryRecord{
+		Status:     DeliveryStatusPending,
+		Event:      &snapshot,
+		Generation: generation + 1,
+		CreatedAt:  createdAt,
+		UpdatedAt:  now,
+	}
+}
+
+// pruneTerminalRecords removes expired delivered/dead-letter records and trims
+// dead-letter records beyond the per-destination cap (oldest first). It returns
+// whether anything changed.
+func pruneTerminalRecords(destState *notificationDestinationState, now time.Time, deliveredTTL, deadLetterTTL time.Duration, deadLetterLimit int) bool {
+	if destState == nil {
+		return false
+	}
+	changed := false
+	for key, record := range destState.Records {
+		if record == nil {
+			delete(destState.Records, key)
+			changed = true
+			continue
+		}
+		switch record.Status {
+		case DeliveryStatusDelivered:
+			deliveredAt := record.DeliveredAt
+			if deliveredAt == nil {
+				deliveredAt = &record.UpdatedAt
+			}
+			if deliveredTTL > 0 && deliveredAt.Before(now.Add(-deliveredTTL)) {
+				delete(destState.Records, key)
+				changed = true
+			}
+		case DeliveryStatusDeadLetter:
+			deadAt := record.DeadLetterAt
+			if deadAt == nil {
+				deadAt = &record.UpdatedAt
+			}
+			if deadLetterTTL > 0 && deadAt.Before(now.Add(-deadLetterTTL)) {
+				delete(destState.Records, key)
+				changed = true
+			}
+		}
+	}
+
+	if deadLetterLimit <= 0 {
+		return changed
+	}
+
+	type deadCandidate struct {
+		key  string
+		when time.Time
+	}
+	candidates := make([]deadCandidate, 0)
+	for key, record := range destState.Records {
+		if record == nil || record.Status != DeliveryStatusDeadLetter {
+			continue
+		}
+		when := record.DeadLetterAt
+		if when == nil {
+			when = &record.UpdatedAt
+		}
+		candidates = append(candidates, deadCandidate{key: key, when: when.UTC()})
+	}
+	if len(candidates) <= deadLetterLimit {
+		return changed
+	}
+	sort.Slice(candidates, func(i, j int) bool {
+		if !candidates[i].when.Equal(candidates[j].when) {
+			return candidates[i].when.Before(candidates[j].when)
+		}
+		return candidates[i].key < candidates[j].key
+	})
+	for _, candidate := range candidates[:len(candidates)-deadLetterLimit] {
+		delete(destState.Records, candidate.key)
+		changed = true
+	}
+	return changed
+}
+
+// evictTerminalRecords persists TTL/cap pruning across all destinations.
+func (m *NotificationMonitor) evictTerminalRecords(ctx context.Context, now time.Time) {
+	m.stateMu.Lock()
+	m.applyStateTransitionLocked(ctx, func(candidate *notificationMonitorState) bool {
+		changed := false
+		for key, destination := range candidate.Destinations {
+			if destination == nil {
+				delete(candidate.Destinations, key)
+				changed = true
+				continue
+			}
+			if pruneTerminalRecords(destination, now, m.cfg.SeenTTL, m.cfg.DeadLetterTTL, m.cfg.DeadLetterLimit) {
+				changed = true
+			}
+			if len(destination.Records) == 0 {
+				delete(candidate.Destinations, key)
+				changed = true
+			}
+		}
+		return changed
+	})
+	m.stateMu.Unlock()
+}
