 // decodeSpec returns the embedded OpenAPI spec as raw JSON bytes,
diff --git a/api/v1/api.yaml b/api/v1/api.yaml
index 53bb1bc9f..a7af1eebd 100644
--- a/api/v1/api.yaml
+++ b/api/v1/api.yaml
@@ -5812,6 +5812,328 @@ paths:
               schema:
                 $ref: "#/components/schemas/Error"
 
+  /notification-deliveries:
+    get:
+      summary: "List notification delivery records"
+      description: "Returns paginated notification delivery lifecycle records (pending, delivered, and dead-lettered). Developer, manager, or admin only."
+      operationId: "listNotificationDeliveries"
+      tags:
+        - "notifications"
+      parameters:
+        - $ref: "#/components/parameters/RemoteNode"
+        - name: "status"
+          in: "query"
+          required: false
+          description: "Filter by lifecycle status. Repeat the parameter or pass a comma-separated list."
+          schema:
+            type: "array"
+            items:
+              type: "string"
+              enum: ["pending", "delivered", "dead_letter"]
+          style: "form"
+          explode: true
+        - name: "destination"
+          in: "query"
+          required: false
+          description: "Exact destination identifier to filter by."
+          schema:
+            type: "string"
+        - name: "cursor"
+          in: "query"
+          required: false
+          description: "Opaque pagination cursor returned by a previous call."
+          schema:
+            type: "string"
+        - name: "limit"
+          in: "query"
+          required: false
+          description: "Page size (default 50, maximum 200)."
+          schema:
+            type: "integer"
+            minimum: 1
+            maximum: 200
+            default: 50
+      responses:
+        "200":
+          description: "Page of notification delivery records"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/NotificationDeliveryListResponse"
+        "400":
+          description: "Invalid filter or pagination cursor"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "403":
+          description: "Forbidden - insufficient permissions"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        default:
+          description: "Unexpected error"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+
+  /notification-deliveries/redrive:
+    post:
+      summary: "Redrive dead-lettered notification deliveries"
+      description: |
+        Reopens the selected dead-lettered records as a fresh pending generation
+        and queues them for immediate delivery. Records that are already pending
+        or delivered, or that no longer exist, return a stable per-record outcome
+        without being duplicated. Redrive is executed by the monitor instance
+        that currently owns the delivery lease. Developer, manager, or admin only.
+      operationId: "redriveNotificationDeliveries"
+      tags:
+        - "notifications"
+      parameters:
+        - $ref: "#/components/parameters/RemoteNode"
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/NotificationDeliveryRedriveRequest"
+      responses:
+        "200":
+          description: "Per-record redrive outcomes"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/NotificationDeliveryRedriveResponse"
+        "400":
+          description: "Invalid request or record id"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "403":
+          description: "Forbidden - insufficient permissions"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "503":
+          description: "No delivery controller is active on this process"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        default:
+          description: "Unexpected error"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+
+  /notification-deliveries/{recordId}:
+    get:
+      summary: "Get a notification delivery record"
+      description: "Returns a single notification delivery record by its opaque id. Developer, manager, or admin only."
+      operationId: "getNotificationDelivery"
+      tags:
+        - "notifications"
+      parameters:
+        - $ref: "#/components/parameters/RemoteNode"
+        - name: "recordId"
+          in: "path"
+          required: true
+          description: "Opaque delivery record id."
+          schema:
+            type: "string"
+      responses:
+        "200":
+          description: "Notification delivery record"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/NotificationDeliveryRecord"
+        "403":
+          description: "Forbidden - insufficient permissions"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "404":
+          description: "Record not found"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        default:
+          description: "Unexpected error"
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+
+  /incident-deliveries:
+    get:
+      summary: "List incident delivery records"
+      description: "Returns paginated incident delivery lifecycle records (pending, delivered, and dead-lettered). Incident management requires an active Dagu license or trial. Developer, manager, or admin only."
+      operationId: "listIncidentDeliveries"
+      tags:
+        - "incidents"
+      parameters:
+        - $ref: "#/components/parameters/RemoteNode"
+        - name: "status"
+          in: "query"
+          required: false
+          description: "Filter by lifecycle status. Repeat the parameter or pass a comma-separated list."
+          schema:
+            type: "array"
+            items:
+              type: "string"
+              enum: ["pending", "delivered", "dead_letter"]
+          style: "form"
+          explode: true
+        - name: "destination"
+          in: "query"
+          required: false
+          description: "Exact destination identifier to filter by."
+          schema:
+            type: "string"
+        - name: "cursor"
